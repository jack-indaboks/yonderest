# Building modules against the engine.
#
# A module builds against the engine's public headers and the modules its module.json requires,
# and nothing else. SDL belongs to the modules that say they use it; JSON belongs to the engine.
# Both are installed system-wide, where any compiler would find them, so a fenced target sees a
# stand-in for each of their headers that stops the build and says why.

function(yonderest_fence target library)
    set(fence ${CMAKE_BINARY_DIR}/fences/${library})
    if(library STREQUAL "SDL3")
        find_path(YONDEREST_SDL3_HEADERS SDL3/SDL.h REQUIRED)
        set(headers ${YONDEREST_SDL3_HEADERS})
        set(folder SDL3)
        set(reason "SDL belongs to the display and the controls")
    elseif(library STREQUAL "json")
        find_path(YONDEREST_JSON_HEADERS json/json.h PATHS ${JsonCpp_INCLUDE_DIRS} REQUIRED)
        set(headers ${YONDEREST_JSON_HEADERS})
        set(folder json)
        set(reason "JSON is read and written by the engine alone")
    else()
        message(FATAL_ERROR "No fence for ${library}")
    endif()
    if(NOT EXISTS ${fence}/${folder})
        file(GLOB names RELATIVE ${headers}/${folder} ${headers}/${folder}/*.h)
        foreach(name ${names})
            file(WRITE ${fence}/${folder}/${name} "#error \"${reason}: ${folder}/${name} is outside this module's boundary\"\n")
        endforeach()
    endif()
    target_include_directories(${target} BEFORE PRIVATE ${fence})
endfunction()

# yonderest_module([USES <libraries>...])
# Builds the module in the current directory from module.json, src/ and include/.
function(yonderest_module)
    cmake_parse_arguments(MODULE "" "" "USES" ${ARGN})
    set(declaration_file ${CMAKE_CURRENT_SOURCE_DIR}/module.json)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${declaration_file})
    file(READ ${declaration_file} declaration)
    string(JSON id GET ${declaration} id)
    string(JSON version GET ${declaration} version)
    set(target yonderest-${id})
    file(GLOB sources CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp)
    add_library(${target} STATIC ${sources})
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
    set_target_properties(${target} PROPERTIES VERSION ${version})
    if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/include)
        target_include_directories(${target} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
    endif()
    target_link_libraries(${target} PUBLIC yonderest-engine)
    string(JSON requires ERROR_VARIABLE none GET ${declaration} requires)
    if(requires)
        string(JSON count LENGTH ${requires})
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(i RANGE ${last})
                string(JSON dependency MEMBER ${requires} ${i})
                target_link_libraries(${target} PRIVATE yonderest-${dependency})
            endforeach()
        endif()
    endif()
    target_link_libraries(${target} PRIVATE ${MODULE_USES})
    if(NOT "SDL3::SDL3" IN_LIST MODULE_USES)
        yonderest_fence(${target} SDL3)
    endif()
    yonderest_fence(${target} json)
endfunction()
